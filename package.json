{
  "name": "slc-sales-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "node --check public/app.js && node --check public/demo-data.js && npm test",
    "dev": "node scripts/serve.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "preview:cloudflare": "npm run build && wrangler dev"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  }
}
